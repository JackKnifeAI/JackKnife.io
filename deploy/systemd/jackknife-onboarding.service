[Unit]
Description=JackKnife customer onboarding API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/jackknife-site
EnvironmentFile=/etc/jackknife/onboarding.env
ExecStart=/usr/bin/python3 -m onboarding.server.app --host 127.0.0.1 --port 8790
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/jackknife-site/onboarding/clients /opt/jackknife-site/onboarding/server

[Install]
WantedBy=multi-user.target
